{
  "name": "@easy-complete/autocomplete-app",
  "private": true,
  "license": "MIT",
  "version": "2.3.2",
  "repository": "https://github.com/chen86860/easy-complete",
  "type": "module",
  "scripts": {
    "set-host": "ec settings developer.autocomplete.host http://localhost:3124",
    "remove-host": "ec settings developer.autocomplete.host --delete",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "serve": "vite preview --port 3124",
    "test": "vitest",
    "lint": "eslint src --report-unused-disable-directives && prettier --check src",
    "lint:fix": "eslint src --fix && prettier --write src",
    "clean": "rm -rf dist"
  },
  "browserslist": [
    "Safari >= 15"
  ],
  "dependencies": {
    "@easy-complete/api-bindings-wrappers": "workspace:^",
    "@easy-complete/api-bindings": "workspace:~",
    "@easy-complete/autocomplete-parser": "workspace:^",
    "@easy-complete/proto": "workspace:^",
    "@easy-complete/shell-parser": "workspace:^",
    "@bufbuild/protobuf": "2.13.0",
    "@fig/autocomplete-helpers": "^2.0.0",
    "@fig/autocomplete-shared": "^1.1.2",
    "deep-object-diff": "^1.1.9",
    "loglevel": "^1.9.2",
    "react-dom": "^19.2.8",
    "react-window": "^1.8.11",
    "react": "^19.2.8",
    "tailwind-merge": "^3.2.0",
    "use-resize-observer": "^10.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@easy-complete/eslint-config": "workspace:^",
    "@easy-complete/types": "workspace:^",
    "@easy-complete/fuzzysort": "workspace:^",
    "@easy-complete/shared": "workspace:^",
    "@types/node": "^26.2.0",
    "@types/react-dom": "^19.2.4",
    "@types/react-window": "^1.8.8",
    "@types/react": "^19.2.18",
    "@vitejs/plugin-react": "^6.0.5",
    "@withfig/autocomplete-types": "^1.31.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "5.8.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "bundledDependencies": [
    "@easy-complete/fuzzysort",
    "@easy-complete/shared"
  ]
}
