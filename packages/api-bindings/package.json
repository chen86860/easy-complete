  "author": "Easy Complete Contributors",
  "repository": "https://github.com/chen86860/easy-complete",
  "type": "module",
  "exports": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist/",
    "build": "pnpm clean && pnpm generate-requests && tsc",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "prepublishOnly": "pnpm build",
    "generate-requests": "tsx codegen/generate-requests.ts && biome format --write src/requests.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@easy-complete/proto": "workspace:^"
  },
  "devDependencies": {
    "@easy-complete/tsconfig": "workspace:^",
    "@tsconfig/recommended": "^1.0.13",
    "@types/node": "^26.6.6",
    "@typescript/analyze-trace": "^0.11.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  }
}
