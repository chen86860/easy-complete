{
  "name": "easy-complete",
  "private": true,
  "author": "Easy Complete Contributors",
  "repository": "https://github.com/chen86860/easy-complete",
  "license": "MIT",
  "packageManager": "pnpm@11.14.0",
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "build": "turbo build",
    "b": "turbo build",
    "format": "cargo fmt",
    "clippy": "cargo clippy --locked --workspace --color always -- -D warnings",
    "test": "vitest",
    "test:ci": "vitest run --run --coverage",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check THIRD_PARTY_NOTICES.txt",
    "dev": "turbo dev",
    "dev:autocomplete": "pnpm -C packages/autocomplete-app dev",
    "preview:autocomplete": "pnpm -C packages/autocomplete-app preview",
    "clean": "turbo clean",
    "prepare": "husky",
    "precommit": "lint-staged --config .lintstagedrc.mjs",
    "setup": "bash scripts/setup.sh"
  },
  "devDependencies": {
    "@chen86860/autocomplete-specs": "3.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "micromatch": "^4.0.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "turbo": "^2.10.9",
    "vitest": "^4.1.10"
  }
}
