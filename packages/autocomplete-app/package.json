{
  "name": "@easy-complete/autocomplete-app",
  "private": true,
  "license": "MIT",
  "version": "2.8.0-beta.8",
  "repository": "https://github.com/chen86860/easy-complete",
  "type": "module",
  "scripts": {
    "set-host": "ec settings developer.autocomplete.host http://localhost:3124",
    "remove-host": "ec settings developer.autocomplete.host --delete",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "serve": "vite preview --port 3124",
    "test": "vitest",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "clean": "rm -rf dist"
  },
  "browserslist": [
    "Safari >= 15"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@easy-complete/api-bindings": "workspace:~",
    "@easy-complete/api-bindings-wrappers": "workspace:^",
    "@easy-complete/autocomplete-parser": "workspace:^",
    "@easy-complete/proto": "workspace:^",
    "@easy-complete/shell-parser": "workspace:^",
    "@fig/autocomplete-helpers": "workspace:*",
    "@fig/autocomplete-shared": "workspace:*",
    "deep-object-diff": "^1.1.9",
    "loglevel": "^1.9.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-window": "^1.8.11",
    "tailwind-merge": "^3.7.0",
    "use-resize-observer": "^10.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@easy-complete/fuzzysort": "workspace:^",
    "@easy-complete/shared": "workspace:^",
    "@easy-complete/types": "workspace:^",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^6.3.0",
    "@withfig/autocomplete-types": "workspace:*",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "vite": "^8.3.7",
    "vitest": "^4.1.12"
  },
  "bundledDependencies": [
    "@easy-complete/fuzzysort",
    "@easy-complete/shared"
  ]
}
