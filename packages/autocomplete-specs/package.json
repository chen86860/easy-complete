{
  "name": "@easy-complete/autocomplete-specs",
  "private": true,
  "version": "3.1.3",
  "description": "Completion specs bundled into Easy Complete",
  "license": "MIT",
  "repository": "https://github.com/chen86860/easy-complete",
  "type": "module",
  "scripts": {
    "build": "autocomplete-tools compile && node scripts/smoke-built-specs.mjs",
    "dev": "autocomplete-tools dev",
    "create-spec": "autocomplete-tools create-spec",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && tsc --noEmit",
    "lint:fix": "biome check --write .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@fig/autocomplete-generators": "workspace:*",
    "@fig/autocomplete-helpers": "workspace:*",
    "semver": "^7.8.6",
    "strip-json-comments": "^5.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^26.6.6",
    "@withfig/autocomplete-tools": "workspace:*",
    "@withfig/autocomplete-types": "workspace:*",
    "typescript": "6.0.3"
  }
}
