{
  "name": "@easy-complete/api-bindings",
  "version": "0.2.0",
  "license": "MIT",
  "author": "Easy Complete Contributors",
  "repository": "https://github.com/chen86860/easy-complete",
  "type": "module",
  "exports": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist/",
    "build": "pnpm clean && pnpm generate-requests && tsc",
    "lint": "eslint src && prettier --check src",
    "lint:fix": "eslint --fix src && prettier --write src",
    "precommit": "lint-staged",
    "prepublishOnly": "pnpm build",
    "generate-requests": "tsx codegen/generate-requests.ts && prettier -w src/requests.ts"
  },
  "dependencies": {
    "@easy-complete/proto": "workspace:^",
    "@bufbuild/protobuf": "2.13.0"
  },
  "devDependencies": {
    "@easy-complete/eslint-config": "workspace:^",
    "@easy-complete/tsconfig": "workspace:^",
    "@tsconfig/recommended": "^1.0.13",
    "@types/node": "^22.15.20",
    "@typescript/analyze-trace": "^0.11.1",
    "eslint": "^10.8.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.1",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": "npx eslint --cache --fix"
  }
}
