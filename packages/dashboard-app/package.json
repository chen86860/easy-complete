  },
  "devDependencies": {
    "@easy-complete/eslint-config": "workspace:^",
    "@easy-complete/types": "workspace:^",
    "@types/node": "^22.15.20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.3",
    "eslint": "^9.39.5",
    "postcss": "^8.5.25",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.19",
    "typescript": "6.0.3",
